#!/usr/bin/env bash
# .githooks/commit-msg
#
# Validates the commit message against Conventional Commits v1.0.0.
# On rejection, prints the structure + examples so you can fix it.
#
# Bypass (use sparingly): git commit --no-verify

set -eu

COMMIT_MSG_FILE="$1"

# Strip comments and trailing blanks for validation
msg_clean=$(grep -v '^\s*#' "$COMMIT_MSG_FILE" | sed -e '/^$/N;/^\n$/D')
first_line=$(printf '%s\n' "$msg_clean" | head -n1)

# Skip validation for merge/revert/fixup commits and empty messages
if [[ -z "$first_line" ]]; then
  exit 0  # git will reject empty itself
fi
case "$first_line" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*|"amend!"*) exit 0 ;;
esac

# Load config for the list of allowed types
CONFIG="${CGIT_CONFIG:-$HOME/.config/conventional-git/config.sh}"
if [[ -r "$CONFIG" ]]; then
  # shellcheck source=/dev/null
  source "$CONFIG"
fi

# Fallback type list
if [[ -z "${CGIT_TYPES:-}" ]]; then
  CGIT_TYPES=(
    "feat:" "fix:" "docs:" "style:" "refactor:" "perf:"
    "test:" "build:" "ci:" "chore:" "revert:"
  )
fi

# Build alternation regex of allowed types
types_alt=""
for entry in "${CGIT_TYPES[@]}"; do
  t="${entry%%:*}"
  types_alt="${types_alt}|${t}"
done
types_alt="${types_alt#|}"

# Conventional Commits pattern:
#   type(scope)?!?: subject
#   - type: one of the allowed types
#   - scope: optional, parenthesized, [a-z0-9/_-]+
#   - !: optional breaking-change marker
#   - colon + single space
#   - subject: ≥1 char, no trailing period
pattern="^(${types_alt})(\([a-z0-9_/-]+\))?!?: .+[^.]$"

# Soft limit: subject ≤72 chars (hard rule is ≤100 in many configs;
# we warn at 72 which is the widely-cited best practice)
subject_len=${#first_line}

print_help() {
  local reason="$1"
  cat >&2 <<EOF

────────────────────────────────────────────────────────────────
✗ Commit rejected: ${reason}
────────────────────────────────────────────────────────────────

  Your message:
    ${first_line}

  Required structure:
    <type>(<scope>): <subject>

    [optional body]

    [optional footer(s)]

  Valid types:
    ${types_alt//|/, }

  Examples:
    feat(cli): add --json output flag
    fix(api): handle null response from /users endpoint
    feat(auth)!: switch from JWT to session cookies
    docs: clarify branch naming in CONTRIBUTING
    chore(deps): bump typescript from 5.6 to 5.7

  Rules:
    • subject in imperative mood ("add" not "added")
    • no trailing period
    • subject ≤72 chars (yours: ${subject_len})
    • breaking change: use "type!:" AND "BREAKING CHANGE:" footer

  Bypass (emergencies only):  git commit --no-verify

────────────────────────────────────────────────────────────────
EOF
}

if ! [[ "$first_line" =~ $pattern ]]; then
  print_help "subject line doesn't match Conventional Commits format"
  exit 1
fi

if (( subject_len > 72 )); then
  print_help "subject line is ${subject_len} chars (max 72)"
  exit 1
fi

# Check for BREAKING CHANGE marker consistency
has_bang=0
breaking_re='^[a-z]+(\([^)]+\))?!'
[[ "$first_line" =~ $breaking_re ]] && has_bang=1
has_footer=0
grep -qE '^BREAKING[ -]CHANGE: .+' "$COMMIT_MSG_FILE" && has_footer=1

if (( has_bang == 1 && has_footer == 0 )); then
  cat >&2 <<EOF

────────────────────────────────────────────────────────────────
⚠  Warning: subject has "!" but no "BREAKING CHANGE:" footer
────────────────────────────────────────────────────────────────
  For tooling compatibility (semver bumping, changelog generation),
  breaking changes should have BOTH the "!" marker AND a footer:

    feat(api)!: replace v1 with v2 endpoints

    BREAKING CHANGE: clients must migrate to /v2 paths.

  Continuing anyway. If this is intentional, ignore this warning.
────────────────────────────────────────────────────────────────
EOF
fi

exit 0
